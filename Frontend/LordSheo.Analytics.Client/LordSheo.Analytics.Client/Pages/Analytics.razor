@using ChartJs.Blazor
@using ChartJs.Blazor.BarChart
@using LordSheo.Analytics.Client.Model
@using LordSheo.Analytics.Client.Services
@inject AnalyticsService AnalyticsService

@page "/analytics"

<h3>Event Name Counts</h3>

@if (eventNameCounts == null)
{
    <p>Loading...</p>
}
else
{
    <Chart Config="@barChartConfig" />
}

<h3>Analytics Events</h3>

@if (events == null)
{
    <p><em>Loading...</em></p>
}
else if (!events.Any())
{
    <p>No analytics events found.</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Id</th>
            <th>Event Name</th>
            <th>User Id</th>
            <th>Timestamp (UTC)</th>
            <th>Metadata</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var evt in events)
        {
            <tr>
                <td>@evt.Id</td>
                <td>@evt.EventName</td>
                <td>@evt.UserId</td>
                <td>@evt.Timestamp.ToString("u")</td>
                <td>@evt.MetadataJson</td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<AnalyticsEvent> events;
    
    private Dictionary<string, int> eventNameCounts;
    private BarConfig barChartConfig;

    protected override async Task OnInitializedAsync()
    {
        events = await AnalyticsService.GetEventsAsync();

        eventNameCounts = events
            .GroupBy(e => e.EventName)
            .ToDictionary(g => g.Key, g => g.Count());

        barChartConfig = new BarConfig()
        {
            Options = new BarOptions()
            {
                Responsive = true,
            },
        };

        foreach (var label in eventNameCounts.Keys)
        {
            barChartConfig.Data.Labels.Add(label);
        }
        
        var dataset = new BarDataset<int>(eventNameCounts.Values.ToList())
        {
            Label = "Event Count",
            BackgroundColor = "rgba(54, 162, 235, 0.6)"
        };
        
        barChartConfig.Data.Datasets.Add(dataset);
    }
}